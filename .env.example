# Copy to .env.local to run standalone (outside Docker). Never commit the
# result. On Railway, these variables are set in the service's dashboard
# (Settings -> Variables), not in a file.

# URL the browser uses to reach the backend (cart and wishlist calls). Has to
# be resolvable from the visitor's machine, not an internal Docker name. It is
# baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: a different URL for server-side rendering (e.g. Railway's private
# network). Falls back to NEXT_PUBLIC_API_URL when empty.
API_URL=

STOREFRONT_PORT=3001
